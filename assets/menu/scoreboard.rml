<rml>
  <head>
    <title>Score</title>
    <link rel="stylesheet" type="text/css" href="rkt.rcss"/>
    <link rel="stylesheet" type="text/css" href="common.rcss"/>
    <link type="text/rcss" href="scoreboard.rcss"/>
  </head>

  <body class="background">
		
    <div class="menu-container">
      <div class="menu" data-model="scoreBoard">
        <h2>{{playerWin}}</h2>
          <div id="statsContainer">
            <p class="gamelen">Game lasted {{gameLengthSeconds}} seconds.</p>
            <div id="teamStats">
              <div class="scoreRow scoreHeader">
                <span class="scoreCol scoreTeam">Team</span>
                <span class="scoreCol scorePlayer">Player</span>
                <span class="scoreCol scoreStat">Eggs</span>
                <span class="scoreCol scoreStat">Explosives</span>
                <span class="scoreCol scoreResult">Result</span>
              </div>
              <div data-for="score : playerScores" class="scoreRow" data-class-winnerRow="score.winner">
                <span class="scoreCol scoreTeam">{{score.teamNumber}}</span>
                <span class="scoreCol scorePlayer">{{score.playerNumber}}</span>
                <span class="scoreCol scoreStat">{{score.eggs}}</span>
                <span class="scoreCol scoreStat">{{score.bombs}}</span>
                <span class="scoreCol scoreResult scoreSurvived" data-if="score.survived">survived</span>
                <span class="scoreCol scoreResult scoreDied" data-if="!score.survived">died</span>
              </div>
            </div>
          </div>
	  <button class="tabbed" id="quickstart" autofocus tabindex="1" onclick="start">Play Again</button><br />
	  <button class="tabbed" id="options" tabindex="2" escapeAction="1" onclick="open mainmenu.rml">Main Menu</button><br />
      </div>
    </div>
  </body>

</rml>
