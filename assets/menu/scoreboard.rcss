.menu-container {
  margin-top: 30%;  
}   

.menu {
  font-size: 18pt;
}

#statsContainer {
  margin-top: 5%;
}

.gamelen {
  font-size: 12pt;
  color: #cccccc;
  padding-bottom: 0.5em;
}

#teamStats {
  display: block;
}

/* A centred table: a header row of column titles followed by one row per
   player, grouped by team. Every cell is centred and column widths are shared
   between the header and the data rows so they line up. The winning team's
   rows are brighter and bold so the result reads at a glance. */
.scoreRow {
  display: block;
  font-size: 13pt;
  color: #bbbbbb;
  padding: 0.1em 0;
  text-align: center;
}

/* Column-title row: dimmer, spaced out and underlined to separate it from the
   data below. */
.scoreHeader {
  font-size: 11pt;
  color: #888888;
  border-bottom: 1px #555555;
  padding-bottom: 0.3em;
  margin-bottom: 0.3em;
}

.scoreRow.winnerRow {
  color: #ffffff;
  font-weight: bold;
}

/* Shared column geometry - identical widths keep header and data aligned.
   Widths sum to ~86%, leaving headroom for the whitespace gaps RmlUi renders
   between inline-blocks so a long heading ("Explosives") never wraps the row.
   The row is centred, so the slack splits into left/right margins. */
.scoreCol {
  display: inline-block;
  text-align: center;
}

.scoreTeam {
  width: 14%;
}

.scorePlayer {
  width: 16%;
}

.scoreStat {
  width: 22%;
}

.scoreResult {
  width: 14%;
}

.scoreSurvived {
  color: #7CFC7C;
}

.scoreDied {
  color: #d06060;
}

.invisible {
  display: none;
}
