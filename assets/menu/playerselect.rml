<rml>
  <head>
    <title>Player Select</title>
    <link rel="stylesheet" type="text/rcss" href="rkt.rcss"/>
    <link rel="stylesheet" type="text/rcss" href="common.rcss"/>
    <link rel="stylesheet" type="text/rcss" href="playerselect.rcss"/>
  </head>

  <body class="background">

    <div data-model="playersSelect">

      <div id="header" class="header-container">
        <div class="menu">
          <button row="0" col="0" class="tabbed" id="quickstart" tabindex="1" onclick="start" onkeydown="start">Start Game</button><br />
          <button row="1" col="0" class="tabbed" id="totalplayers" tabindex="2" data-event-click="toggleNumPlayers" data-event-keydown="toggleNumPlayers">Total Players: {{players.size}}</button><br />
        </div>
      </div>

		
      <section class="strips">
        <article data-for="player : players" class="strip" data-attr-col="it_index" data-attr-id="'article-' + it_index" data-attr-playerId="player.id">
          <div class="stripContent">
            <h1 data-attr-id="'h1-' + player.id" data-class-red="it_index == 0" data-class-blue="it_index == 1" data-class-green="it_index == 2" data-class-yellow="it_index == 3">Player {{player.id + 1}}</h1>
            <!-- We'll do teams later --> <!-- <h1 data-attr-col="it_index" data-attr-playerId="player.id" data-class-red="it_index == 0" data-class-blue="it_index == 1" data-class-green="it_index == 2" data-class-yellow="it_index == 3">Team {{player.team + 1}}</h1> -->
            <!-- player 1 is selected by default on loading of this page -->
            <img data-attr-id="'img-id-' + player.id" class="tabbed" data-attr-col="it_index" row="2" data-attr-playerId="player.id" data-class-playerselected="it_index == 0" data-class-red="it_index == 0" data-class-blue="it_index == 1" data-class-green="it_index == 2" data-class-yellow="it_index == 3" data-event-click="togglePlayerPortrait" data-event-keydown="togglePlayerPortrait" data-attr-src="player.portrait" data-attr-tabindex="(it_index * 2) + 3" />
            <p>Control: <button data-attr-id="'btn-ai-' + player.id" class="tabbed joinplayer" data-attr-col="it_index" row="3" data-attr-playerId="player.id" data-attr-tabindex="(it_index *2) + 4" data-event-keydown="togglePlayerAI" data-event-click="togglePlayerAI" data-rml="player.human == 1 ? 'Human' : 'CPU'" /></p>
          </div>
        </article>
      </section>

      <div style="clear: both;"><!-- nc --></div>


      <div id="footer" class="footer-container">
        <div class="menu">
          <button class="tabbed" row="4" col="0" id="options" data-attr-tabindex="(players.size * 2) + 3" escapeAction="1" onclick="open mainmenu.rml" onkeydown="open mainmenu.rml">Main Menu</button><br />
        </div>
      </div>
      <div class="controller" data-for="controller : controllers" data-attr-controllerId="controller.index">
        <img data-attr-style="'padding-right:' + it_index * 44 + 'px'" height="40px" width="40px" data-attr-col="it_index" data-class-red="controller.index == 0" data-class-blue="controller.index == 1" data-class-green="controller.index == 2" data-class-yellow="controller.index == 3" data-attr-src="controller.imageSrc"  />
      </div>
    </div>
  </body>

</rml>
