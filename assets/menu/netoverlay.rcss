/* The in-game network overlay (brief 08), drawn over the world by RmlUi: who the match is waiting for, who
   left, a desync, and a small connection line. It never takes focus and has no background of its own. */
body.overlay {
  background-color: rgba(0,0,0,0);
  font-size: 13pt;
  color: white;
}

#stallbox {
  display: none;
  position: absolute;
  left: 6px;
  top: 6px;
  padding: 4px 10px;
  background-color: rgba(160,0,0,230);
  color: white;
  font-size: 14pt;
  font-weight: bold;
}

#toasts {
  position: absolute;
  left: 0;
  top: 40px;
  width: 100%;
  text-align: center;
}

#toasts p {
  display: inline-block;
  margin: 0 0 4px 0;
  padding: 2px 10px;
  background-color: rgba(0,0,0,200);
  color: #ffee88;
  font-size: 13pt;
}

#desyncbox {
  display: none;
  position: absolute;
  left: 5%;
  top: 30%;
  width: 90%;
  padding: 8px 12px;
  background-color: rgba(120,0,0,235);
  color: white;
  font-size: 13pt;
  white-space: normal;
}

#netstatusline {
  position: absolute;
  left: 6px;
  bottom: 4px;
  font-size: 10pt;
  color: rgba(255,255,255,170);
}
