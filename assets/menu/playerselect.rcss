.strips {
  min-height: 70vh;
  text-align: center;
  overflow: hidden;
  color: white;
}

.strip {
  float: left;
  position: relative;
  width: 25%;
  min-height: 70vh;
  overflow: hidden;
}

.strip#0 {
}

.strip#1 {
}

.strip#2 {
}

.strip#3 {
}

.strip#4 {
}

.strip#5 {
}

.stripContent {
  align-items: center;
  justify-content: center;
  top: 0;
  left: 0;
  width: 100%;
  height: 40vh;
  padding-top: 10vh;
}

.stripContent img {
  padding: 3px;
}

.stripContent img {
  border-radius: 3px;
  border: 3px grey;
}

.stripContent img.red.playerselected {
  border-radius: 3px;
  border: 3px red;
}
.stripContent img.blue.playerselected {
  border-radius: 3px;
  border: 3px #6da8f5;
}
.stripContent img.green.playerselected {
  border-radius: 3px;
  border: 3px green;
}
.stripContent img.yellow.playerselected {
  border-radius: 3px;
  border: 3px yellow;
}
.stripContent img.cyan.playerselected {
  border-radius: 3px;
  border: 3px #17c8d2;
}
.stripContent img.orange.playerselected {
  border-radius: 3px;
  border: 3px #dd7817;
}

.stripContent img:hover {
  /* image-color: rgb(150,150,200);*/
  border-radius: 3px;
  border: 3px rgb(150,150,200);
}

.stripContent img:focus {
  border-radius: 3px;
  border: 3px rgb(120,120,255);
}

h1 {
  display: block;
  font-weight: bold;
  padding-top: 0.5em;
  padding-bottom: 1em;
}

p {
  padding-top: 1em;
  font-size: 12pt;
  font-weight: bold;
}

.red {
  color: red;
}

.blue {
  color:#6da8f5;
}

.green {
  color: green;
}

.yellow {
  color: yellow;
}

.cyan {
  color: #17c8d2;
}

.orange {
  color: #dd7817;
}

.header-container {
  float: left;
  margin-top: 2vh;
  width: 100vw;
  height: 10vh;  
}

.footer-container {
  float:left;
  width: 100vw;
  height: 10vh;
}

div.controller {
  position: absolute;
  bottom: 0;
  right: 0;
}

.menu {
  font-size: 18pt;
}

.mapsize {
  font-size: 12pt;
  color: #cccccc;
}

.warning {
  display: block;
  font-size: 12pt;
  font-weight: bold;
  color: #ff6666;
  padding-top: 0.5em;
}

/* Start button greyed out while the map is too short for the player count. */
button.disabled {
  color: #777777;
}

/* The Control button's label now cycles through CPU / Keyboard 1-4 / Pad N
   (cyclePlayerControl) instead of just CPU/Human - "Keyboard 4" is the
   longest label, so keep it on one line and give it a bit more room than the
   old CPU/Human toggle needed, especially at 6 narrow player columns. */
.joinplayer {
  white-space: nowrap;
  font-size: 11pt;
  padding: 4px 8px;
}

