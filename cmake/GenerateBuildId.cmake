# Generates BuildId.cpp: the build id of src/BuildId.h (read that comment for what is
# hashed and why). Run as a script, by the bitriot_build_id target on every build:
#
#   cmake -DBITRIOT_SOURCE_DIR=<repo> -DBITRIOT_ROOTS=<file listing the simulation's
#         sources, one path per line, relative to the repo> -DBITRIOT_OUTPUT=<BuildId
#         .cpp to write> -P GenerateBuildId.cmake
#
# It also writes <BITRIOT_OUTPUT without .cpp>.inputs.txt, the files that went into the
# hash. Both outputs are only rewritten when their content changed, so an unchanged
# simulation does not trigger a rebuild.

cmake_minimum_required(VERSION 3.15)

foreach(var BITRIOT_SOURCE_DIR BITRIOT_ROOTS BITRIOT_OUTPUT)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "GenerateBuildId.cmake: -D${var}=... is required")
  endif()
endforeach()

get_filename_component(root "${BITRIOT_SOURCE_DIR}" ABSOLUTE)

# Roots: the simulation's translation units.
file(STRINGS "${BITRIOT_ROOTS}" roots)
if(NOT roots)
  message(FATAL_ERROR "GenerateBuildId.cmake: ${BITRIOT_ROOTS} lists no sources")
endif()

set(pending "")
foreach(r IN LISTS roots)
  if(NOT r STREQUAL "")
    get_filename_component(abs "${r}" ABSOLUTE BASE_DIR "${root}")
    list(APPEND pending "${abs}")
  endif()
endforeach()

# Closure over #include "..." and #include <...> that resolve to a project file.
set(seen "")
while(pending)
  list(POP_BACK pending file)
  list(FIND seen "${file}" already)
  if(NOT already EQUAL -1)
    continue()
  endif()
  if(NOT EXISTS "${file}")
    message(FATAL_ERROR "GenerateBuildId.cmake: ${file} does not exist")
  endif()
  list(APPEND seen "${file}")
  get_filename_component(dir "${file}" DIRECTORY)
  file(READ "${file}" text)
  string(REGEX MATCHALL "(^|\n)[ \t]*#[ \t]*include[ \t]*[<\"][^>\"\n]+[>\"]" lines "${text}")
  foreach(line IN LISTS lines)
    string(REGEX REPLACE "^.*[<\"]([^>\"\n]+)[>\"]$" "\\1" target "${line}")
    foreach(base "${dir}" "${root}/src" "${root}")
      if(EXISTS "${base}/${target}" AND NOT IS_DIRECTORY "${base}/${target}")
        get_filename_component(resolved "${base}/${target}" ABSOLUTE)
        list(APPEND pending "${resolved}")
        break()
      endif()
    endforeach()
  endforeach()
endwhile()

# Relative paths, sorted.
set(relative "")
foreach(file IN LISTS seen)
  file(RELATIVE_PATH rel "${root}" "${file}")
  list(APPEND relative "${rel}")
endforeach()
list(SORT relative)

set(stream "")
set(inputs "")
foreach(rel IN LISTS relative)
  file(READ "${root}/${rel}" text)
  string(REPLACE "\r" "" text "${text}")
  string(APPEND stream "${rel}\n${text}\n--\n")
  string(APPEND inputs "${rel}\n")
endforeach()

string(MD5 md5 "${stream}")
string(SUBSTRING "${md5}" 0 16 id)

set(cpp "// Generated by cmake/GenerateBuildId.cmake. Do not edit.\n#include \"BuildId.h\"\n\nuint64_t bitriotBuildId()\n{\n  return 0x${id}ULL;\n}\n")

function(write_if_changed path content)
  set(old "")
  if(EXISTS "${path}")
    file(READ "${path}" old)
  endif()
  if(NOT old STREQUAL content)
    file(WRITE "${path}" "${content}")
  endif()
endfunction()

get_filename_component(outdir "${BITRIOT_OUTPUT}" DIRECTORY)
get_filename_component(outname "${BITRIOT_OUTPUT}" NAME_WE)
file(MAKE_DIRECTORY "${outdir}")
write_if_changed("${BITRIOT_OUTPUT}" "${cpp}")
write_if_changed("${outdir}/${outname}.inputs.txt" "${inputs}")
